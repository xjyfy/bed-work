<?xml version="1.0" encoding="utf-8"?>
<!-- 整页固定一屏：方向区用 weight=1 吸收剩余高度，其余区块固定行高，正常手机不需要滚动。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- ========== 顶栏：状态 / 设备名 / 设置 ========== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_glass_header"
        android:elevation="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="5dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="未连接"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="3dp"
            android:drawableTint="@color/muted"
            android:ellipsize="end"
            android:maxWidth="210dp"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:text="未绑定设备 · 点击扫码"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_iconbtn"
            android:contentDescription="设置"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            android:tint="@color/text" />
    </FrameLayout>

    <!-- ========== 媒体区 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="上一曲"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_prev"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="播放或暂停"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_playpause"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="下一曲"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_next"
            android:tint="@color/text" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@color/line" />

        <ImageButton
            android:id="@+id/btnVolDown"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="音量减"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_vol_minus"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/btnVolUp"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="音量加"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_vol_plus"
            android:tint="@color/text" />
    </LinearLayout>

    <!-- ========== 工具 + 文件互传（合并为一个分区） ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/btnPaste"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="远程粘贴到电脑"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clipboard"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="粘贴"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnScreenshot"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="电脑截屏到手机"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_monitor"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="截屏"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSendMedia"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="传照片到电脑"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_image"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="照片"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSendFile"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="传文件到电脑"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_folder"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="文件"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 方向环 + 滚轮 + 取消/确定 ========== -->
    <LinearLayout
        android:id="@+id/dpadArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.willen.remotemic.view.RingPadView
                android:id="@+id/ringPad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="方向键" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVideoPlayPause"
                style="@style/Widget.RemoteMic.CenterButton"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:contentDescription="视频播放或暂停"
                android:text="视频"
                app:icon="@drawable/ic_playpause" />

            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnScrollPrev"
                    android:layout_width="50dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_wheel"
                    android:contentDescription="向上滚动"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevrons_up"
                    android:tint="@color/accent" />

                <ImageButton
                    android:id="@+id/btnScrollNext"
                    android:layout_width="50dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_wheel"
                    android:contentDescription="向下滚动"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevrons_down"
                    android:tint="@color/accent" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnCancel"
                android:layout_width="106dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_act"
                android:contentDescription="取消，Esc 键"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text" />

                <TextView
                    style="@style/Widget.RemoteMic.Keycap"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="7dp"
                    android:text="Esc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnOk"
                android:layout_width="106dp"
                android:layout_height="46dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_act"
                android:contentDescription="确定，Enter 键"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_check"
                    android:tint="@color/text" />

                <TextView
                    style="@style/Widget.RemoteMic.Keycap"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="7dp"
                    android:text="Enter" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 语音区（核心） ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_voice_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnSwitcher"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:contentDescription="切换应用"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:alpha="0.72"
                    android:src="@drawable/ic_apps"
                    android:tint="@color/text" />

                <TextView
                    android:id="@+id/tvSwitcherLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="切换应用"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnTabSwitch"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:contentDescription="切换 Tab"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:alpha="0.72"
                    android:src="@drawable/ic_tabs"
                    android:tint="@color/text" />

                <TextView
                    android:id="@+id/tvTabLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="切换 Tab"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:contentDescription="退格"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:alpha="0.72"
                    android:src="@drawable/ic_backspace"
                    android:tint="@color/text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="退格"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnNewChat"
                android:layout_width="58dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_mini"
                android:contentDescription="新会话"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_chat_plus"
                    android:tint="@color/text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="新会话"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnVoice"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_voice"
                android:clickable="true"
                android:contentDescription="按住说话，双击常开"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="24dp">

                        <ImageView
                            android:id="@+id/ivVoiceIcon"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mic_line"
                            android:tint="@color/voice_ink" />

                        <LinearLayout
                            android:id="@+id/voiceWave"
                            android:layout_width="26dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <View
                                android:id="@+id/voiceBar1"
                                android:layout_width="3dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_wave_bar" />

                            <View
                                android:id="@+id/voiceBar2"
                                android:layout_width="3dp"
                                android:layout_height="13dp"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_wave_bar" />

                            <View
                                android:id="@+id/voiceBar3"
                                android:layout_width="3dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_wave_bar" />

                            <View
                                android:id="@+id/voiceBar4"
                                android:layout_width="3dp"
                                android:layout_height="11dp"
                                android:layout_marginEnd="2dp"
                                android:background="@drawable/bg_wave_bar" />

                            <View
                                android:id="@+id/voiceBar5"
                                android:layout_width="3dp"
                                android:layout_height="16dp"
                                android:background="@drawable/bg_wave_bar" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvVoiceTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="按住说话"
                            android:textColor="@color/voice_ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvVoiceSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="双击常开"
                            android:textColor="@color/voice_ink_soft"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/btnSend"
                android:layout_width="58dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mini"
                android:contentDescription="发送"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_send"
                    android:tint="@color/text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="发送"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 快捷区：保持安卓桌面图标样式 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appBtn1"
            style="@style/Widget.RemoteMic.AppIcon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="应用1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appBtn2"
            style="@style/Widget.RemoteMic.AppIcon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="应用2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appBtn3"
            style="@style/Widget.RemoteMic.AppIcon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="应用3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appBtn4"
            style="@style/Widget.RemoteMic.AppIcon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="应用4" />
    </LinearLayout>
</LinearLayout>
