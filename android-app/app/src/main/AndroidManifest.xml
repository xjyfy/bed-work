<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 10 以下才需要写公共下载目录，10+ 走 MediaStore 零权限；limit 到 28 避免商店审核报多余权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 绑定 token 明文存在 SharedPreferences：开着备份就会随自动备份上云、也能被 adb 导出。
         自用工具不需要备份恢复，关掉最简单也最安全。 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:label="手机遥控麦"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemoteMic"
        tools:targetApi="35">

        <!-- singleTask：桌面图标 / 磁贴 / 最近任务多次点开时必须复用同一个实例。
             standard 下会一层层叠出新实例，每个实例各建一条 WebSocket，互相被服务端踢掉，
             表现为"多次点截图就断线重连"。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".scan.QrScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RemoteMic.Scan" />

        <activity
            android:name=".shot.ShotViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.RemoteMic.Shot" />

        <service
            android:name=".service.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 下拉快捷开关（控制中心磁贴）：点一下启动本应用。
             exported 必须 true 并带 BIND_QUICK_SETTINGS_TILE，否则系统不认这个磁贴 -->
        <service
            android:name=".service.AppTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 文件传输期间的短时前台服务：只用于通知栏进度，传完立即停止 -->
        <service
            android:name=".service.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
